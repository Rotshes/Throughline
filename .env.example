# Copy to .env and fill in. .env is gitignored — keep it that way.

OPENROUTER_API_KEY=

# One model for both calls to begin with. The two-call split exists partly so
# this can differ per call later, once the logs justify it.
#
# Model ids go stale. A retired or misspelled id returns HTTP 404 "no endpoints
# found". Check https://openrouter.ai/api/v1/models for what is live today.
# Cheaper alternative: google/gemini-3.5-flash-lite
OPENROUTER_MODEL=google/gemini-3.7-flash

# Hard cap on model calls per user request. Bounds what one run can spend.
MAX_CALLS_PER_REQUEST=4

# Where call records go until Supabase exists (turn 1, step 5).
CALL_LOG_PATH=logs/model-calls.jsonl

# Not needed until step 5.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
