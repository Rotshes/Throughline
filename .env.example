# Copy to .env and fill in. .env is gitignored — keep it that way.
#
# Every one of these must ALSO be set in the Netlify dashboard BEFORE the deploy
# that needs it. Variables added to a live site do not apply until the next
# build — turn 003 spent an hour on an OpenRouter key that was correct all along.
#
# None of these may ever be given a VITE_ prefix. Vite inlines VITE_* into the
# browser bundle, where anyone can read them.

# --- the model ---------------------------------------------------------------
OPENROUTER_API_KEY=

# Model ids go stale. A retired or misspelled id returns HTTP 404 "no endpoints
# found". Check https://openrouter.ai/api/v1/models for what is live today.
#
# On cost: this model bills reasoning as completion tokens. Turn 006 measured
# 2,127 output tokens for about 180 visible words, so a request costs
# $0.005-0.011 rather than the half-cent it looks like.
OPENROUTER_MODEL=google/gemini-3.7-flash

# Hard cap on model calls per user request. Bounds what one run can spend.
# Nothing bounds the number of requests — see the README.
MAX_CALLS_PER_REQUEST=4

# --- the catalogue: IGDB, via Twitch -----------------------------------------
#
# Register an application at https://dev.twitch.tv/console/apps. The client
# credentials are exchanged for a token lasting about 57 days; src/igdb.js
# handles that and re-mints on a 401.
#
# The secret is a password, not an identifier. Rate limit: 4 requests per second
# per client id. Attribution to IGDB is a licence term, not decoration — it is in
# the footer of web/src/App.jsx.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- prices: IsThereAnyDeal --------------------------------------------------
#
# Free key from https://isthereanydeal.com/apps/new. 1,000 requests per five
# minutes. Their terms require attribution and forbid stripping the affiliate
# tags from the URLs they return, so src/deals.js passes their `url` through
# untouched.
#
# A missing key costs the deals row on the front page and nothing else — the row
# reports itself as unavailable rather than taking the page down.
ITAD_API_KEY=

# --- the database ------------------------------------------------------------
#
# Run db/schema.sql once, then migration-002-requests.sql,
# migration-003-library.sql and migration-004-library-source.sql in that order.
#
# The service key bypasses Row Level Security entirely. It belongs here and in
# Netlify's environment variables, nowhere else.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- local only --------------------------------------------------------------
#
# On Netlify there is no persistent filesystem, so this write is skipped and
# Supabase is the record.
CALL_LOG_PATH=logs/model-calls.jsonl

# --- no longer needed --------------------------------------------------------
#
# RAWG_API_KEY was the catalogue until decision 0006. Nothing on the live path
# reads it. src/catalogue.js still does, and still passes its offline checks; it
# goes when the IGDB build has been deployed and proven.
