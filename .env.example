# Copy to .env and fill in. .env is gitignored — keep it that way.
#
# Every one of these must also be set in the Netlify dashboard BEFORE the deploy
# that needs it. Variables added to a live site do not apply until the next
# build — turn 003 spent an hour on an OpenRouter key that was correct all along.

OPENROUTER_API_KEY=

# The game catalogue. Free key from https://rawg.io/apidocs — 20,000 requests a
# month, and their licence requires an active link back to RAWG on every page
# showing their data. That link is in web/src/App.jsx; do not remove it.
RAWG_API_KEY=

# Model ids go stale. A retired or misspelled id returns HTTP 404 "no endpoints
# found". Check https://openrouter.ai/api/v1/models for what is live today.
#
# Note on cost: this model bills reasoning as completion tokens. Turn 006
# measured 2,127 output tokens for about 180 visible words, so a request costs
# $0.005-0.011 rather than the half-cent it looks like.
OPENROUTER_MODEL=google/gemini-3.7-flash

# Hard cap on model calls per user request. Bounds what one run can spend.
# Nothing bounds the number of requests — see the README.
MAX_CALLS_PER_REQUEST=4

# Local call log. On Netlify there is no persistent filesystem, so this write is
# skipped and Supabase is the record.
CALL_LOG_PATH=logs/model-calls.jsonl

# Run db/schema.sql once, then db/migration-002-requests.sql.
# The service key bypasses Row Level Security entirely. It belongs here and in
# Netlify's environment variables, never in a VITE_ prefixed variable — Vite
# inlines those into the browser bundle.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
