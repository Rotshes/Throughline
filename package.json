{
  "name": "throughline",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Pick a kind of game and the platforms you own; get three specific titles with images and a case for each.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "node scripts/check-catalogue.js && node scripts/check-platforms.js && node scripts/check-shortlist.js && node scripts/check-library.js && node scripts/check-detail.js",
    "check:catalogue": "node scripts/check-catalogue.js",
    "check:platforms": "node scripts/check-platforms.js",
    "check:shortlist": "node scripts/check-shortlist.js",
    "check:library": "node scripts/check-library.js",
    "catalogue:pin": "node scripts/pin-vocabularies.js",
    "catalogue:inspect": "node scripts/inspect-catalogue.js",
    "tags:pin": "node scripts/pin-tags.js",
    "candidates": "node scripts/run-candidates.js",
    "shortlist": "node scripts/run-shortlist.js",
    "start": "netlify dev",
    "check:detail": "node scripts/check-detail.js",
    "probe:front": "node scripts/probe-front.js",
    "probe:front2": "node scripts/probe-front-2.js",
    "probe:igdb": "node scripts/probe-igdb.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "dotenv": "^16.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "vite": "^5.4.0",
    "@vitejs/plugin-react": "^4.3.1"
  }
}
