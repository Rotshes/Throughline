{
  "name": "throughline",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Pick a kind of game and the platforms you own; get three specific titles with images and a case for each.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "node scripts/check-catalogue.js && node scripts/check-platforms.js && node scripts/check-shortlist.js && node scripts/check-library.js && node scripts/check-detail.js && node scripts/check-igdb.js && node scripts/check-igdb-catalogue.js && node scripts/check-deals.js && node scripts/check-events.js && node scripts/check-suggested.js && node scripts/check-css.js && node scripts/check-undefined.js",
    "check:catalogue": "node scripts/check-catalogue.js",
    "check:platforms": "node scripts/check-platforms.js",
    "check:shortlist": "node scripts/check-shortlist.js",
    "check:library": "node scripts/check-library.js",
    "catalogue:pin": "node scripts/pin-vocabularies.js",
    "catalogue:inspect": "node scripts/inspect-catalogue.js",
    "tags:pin": "node scripts/pin-tags.js",
    "candidates": "node scripts/run-candidates.js",
    "shortlist": "node scripts/run-shortlist.js",
    "start": "netlify dev",
    "check:detail": "node scripts/check-detail.js",
    "probe:front": "node scripts/probe-front.js",
    "probe:front2": "node scripts/probe-front-2.js",
    "probe:igdb": "node scripts/probe-igdb.js",
    "probe:igdb2": "node scripts/probe-igdb-2.js",
    "check:igdb": "node scripts/check-igdb.js",
    "igdb:inspect": "node scripts/inspect-igdb.js",
    "igdb:pin": "node scripts/pin-igdb.js",
    "igdb:verify": "node scripts/inspect-igdb-catalogue.js",
    "check:igdb-catalogue": "node scripts/check-igdb-catalogue.js",
    "igdb:tags": "node scripts/pin-igdb-tags.js",
    "probe:deals": "node scripts/probe-deals.js",
    "probe:deals2": "node scripts/probe-deals-2.js",
    "check:deals": "node scripts/check-deals.js",
    "probe:news": "node scripts/probe-news.js",
    "probe:igdb-news": "node scripts/probe-igdb-news.js",
    "probe:events": "node scripts/probe-events.js",
    "check:events": "node scripts/check-events.js",
    "check:suggested": "node scripts/check-suggested.js",
    "probe:reviews": "node scripts/probe-reviews.js",
    "check:css": "node scripts/check-css.js",
    "case:5": "node scripts/case-5-injection.js",
    "case:6": "node scripts/case-6-repeatability.js",
    "check:undefined": "node scripts/check-undefined.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "dotenv": "^16.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "vite": "^5.4.0",
    "@vitejs/plugin-react": "^4.3.1",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5"
  }
}
